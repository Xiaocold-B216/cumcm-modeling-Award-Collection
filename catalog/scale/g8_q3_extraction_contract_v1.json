  },
  "binary_matrix_sanity_rule": {
    "rule_id": "OCR-SANITY-BINARY-MATRIX-V1",
    "trigger": "long 0/1 digit runs occur in OCR text",
    "positive_criteria": [
      "at least 4 binary tokens, each at least 18 digits",
      "modal binary-token length is at least 18 and modal-length regularity is at least 0.75",
      "binary-token character ratio is at least 0.45",
      "candidate tokens contain both 0 and 1",
      "at least 2 deterministic source-code or matrix context markers are present",
      "candidate tokens are not all single-symbol runs and not all alternating runs"
    ],
    "negative_criteria": [
      "a single-symbol run of at least 18 digits without positive matrix evidence",
      "an alternating 0/1 run of at least 18 digits without positive matrix evidence",
      "fewer than 4 regular binary tokens, insufficient binary-token ratio, missing 0/1 diversity, or insufficient context"
    ],
    "false_positive_protection": "Numeric runs are accepted only when the complete deterministic matrix evidence predicate passes; repeated-symbol and alternating-noise fixtures remain rejected.",
    "evidence_references": [
      "catalog/scale/g8_q3_batch_repair/CUMCM-2020-B-005/pages/0023.txt",
      "catalog/scale/g8_q3_batch_page_audit.csv",
      "catalog/scale/g8_q3_batch_ocr_audit.csv",
      "catalog/scale/g8_q3_binary_matrix_sanity_validation.csv"
    ]
  },
  "normalization_contract": "Stage 66 whitespace collapse after NUL removal",
  "page_joining_contract": "Stage 66 ordered space join then normalization",
  "content_sanity_rules": "local structural continuity only",
  "alternate_source_gate": "only same identity, readable, SHA-verified membership with fuller text evidence",
  "atomic_persistence_rules": "same-volume temporary directory rename; unknown destinations blocked",
